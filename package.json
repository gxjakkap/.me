{
	"name": "me",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"type": "module",
	"scripts": {
		"prepare": "vp config --hooks --no-agent",
		"dev": "vp run -r dev",
		"build": "vp run -r build",
		"test": "vp run -r test",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"catalog": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
		"vite-plus": "1.0.0-rc.0"
	}
}
